# Authentication
SECRET_KEY=replace-with-a-long-random-secret
CLAIM=replace-with-a-bcrypt-hash

# Database
# DATABASE_TYPE defaults to sqlite. Set mysql to use a MySQL server.
DATABASE_TYPE=sqlite
DATABASE_PATH=db/hermit-crab.sqlite
# MySQL configuration (required only when DATABASE_TYPE=mysql)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_NAME=blog

# Gitalk
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_REPO=
NEXT_PUBLIC_GITHUB_OWNER=
